# Copy to .env.local and fill in from your Supabase project dashboard:
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Secret. Server-only — never referenced from a Client Component.
# Bypasses Row Level Security; used only by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Root domain used to derive tenant subdomains. Locally this stays as
# localhost:3000 and tenants are reached at /t/{slug} instead.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Used by `pnpm db:push` (Supabase CLI). Project Settings → Database.
SUPABASE_DB_PASSWORD=your-database-password

# Connection string used by the migration scripts. Prefer the session-mode
# pooler (port 5432): the direct host `db.<ref>.supabase.co` is IPv6-only and
# fails on IPv4-only networks. Project Settings → Database → Connection string.
SUPABASE_DB_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
